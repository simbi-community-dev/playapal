<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- The beam file the app writes for sharing lives in the external
         files dir; nothing broader is ever exposed. -->
    <external-files-path name="beams" path="." />
    <files-path name="internal" path="." />
    <!-- Lane D: the copy of our own installed APK we hand to a phone that
         has no app yet. sourceDir is world-readable but lives outside every
         FileProvider root, so the shareable copy lands here. -->
    <cache-path name="share-app" path="share-app/" />
</paths>
