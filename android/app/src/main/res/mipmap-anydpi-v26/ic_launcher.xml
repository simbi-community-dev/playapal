<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). Android picks this over the legacy PNGs in
  mipmap-*dpi, which remain for API 24-25 since minSdk is 24.

  Two layers, because the launcher masks and animates them independently: the
  gradient background fills the whole 108dp canvas and the artwork sits inside
  the safe zone, so the icon survives being cropped to a circle, a squircle or
  a rounded square without losing the sun or clipping the horizon lines.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
