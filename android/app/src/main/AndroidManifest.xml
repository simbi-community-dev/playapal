<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- GPS lane (src/geo): on-device only, nothing leaves the phone.
         Android 12+ requires COARSE alongside FINE in the runtime dialog. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Art photos (camp notes): a 320px thumbnail snapped at the piece.
         Declaring CAMERA makes the runtime grant mandatory before
         launchCamera — AddNoteSheet requests it in context. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required=false: declaring the CAMERA permission alone lets Play
         infer camera hardware as REQUIRED and hide the app from
         camera-less devices — which can still pick from the gallery. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Crew (docs/CREW-DESIGN.md Phase B/C): offline crew presence over BLE.
         API 31+ runtime trio; the maxSdkVersion pair covers 30-and-below,
         where scanning additionally rides the location grant the compass
         already asks for. No neverForLocation flag ON PURPOSE: a crew
         sighting IS position data (self-reported in the payload), and
         claiming otherwise would be gaming the declaration. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Phase C: the share session survives the pocket via a foreground
         service (persistent notification = the honest "this is running"
         surface). Types: location keeps the GPS fix flowing under the
         while-in-use grant (the modern alternative to ACCESS_BACKGROUND_
         LOCATION, which we deliberately do NOT request), connectedDevice
         covers the BLE radio work. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Voice notes for the pod's answering machine (FieldAudio): asked in
         context at the record button, never up front. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Friend-card deep links (Friends on playa): the QR encodes
             https://playapal.lol/f#<card>; playapal://friend#<card> is the
             offline-safe custom scheme. The payload rides the FRAGMENT, so
             it never reaches any server either way. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="playapal.lol" android:path="/f" />
            <data android:scheme="https" android:host="www.playapal.lol" android:path="/f" />
        </intent-filter>
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="playapal" android:host="friend" />
        </intent-filter>
        <!-- Beam deep links (small boards over QR): the sibling of the friend
             card — https://playapal.lol/b#<frag> and playapal://beam#<frag>.
             Decoders are anchored on the PATH, so a friend link and a beam
             link can never be mistaken for each other. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="playapal.lol" android:path="/b" />
            <data android:scheme="https" android:host="www.playapal.lol" android:path="/b" />
        </intent-filter>
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="playapal" android:host="beam" />
        </intent-filter>
        <!-- EXACT PATHS, not prefixes. `pathPrefix="/p"` also claimed
             https://playapal.lol/privacy — which is LIVE (200) and is the
             Play Console privacy-policy URL. Once app-link verification
             succeeded, tapping "Privacy policy" in a store listing would open
             Playa Pal, which decodes nothing and returns silently. A Play
             reviewer would have hit that. The same over-claim applied to /f
             (/faq, /friends…) and /b (/board…) with no live collision yet.
             The fragment is not part of Uri.getPath(), so exact-path matching
             still catches #frag payloads.

             Pod invite deep links (docs/WALKIE-LADDER.md §8, rung 0). The
             third member of the family — https://playapal.lol/p#<frag> and
             playapal://pod#<frag>. A pod was the only shareable object in the
             app you could not hand over by pointing a camera at a screen; the
             payload rides the FRAGMENT like its two siblings, so no server
             ever sees a pod code. Decoders are anchored on the PATH, so /f,
             /b and /p can never be mistaken for one another. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="playapal.lol" android:path="/p" />
            <data android:scheme="https" android:host="www.playapal.lol" android:path="/p" />
        </intent-filter>
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="playapal" android:host="pod" />
        </intent-filter>
        <!-- Beam FILES (docs/BEAM-INGRESS-CONTRACT.md §1). A .playapal file
             is JSON with our own MIME, but Android's MimeTypeMap has no entry
             for a custom extension, so a file received through Quick Share
             or opened from Downloads arrives as application/octet-stream on
             a content:// URI whose path does not contain the filename. The
             VIEW filter therefore claims our exact MIME AND octet-stream —
             and deliberately NOT application/json (every JSON on the phone).
             The JS sniffer refuses a non-beam with one honest sentence. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="content" />
            <data android:scheme="file" />
            <data android:mimeType="application/vnd.playapal.beam+json" />
            <data android:mimeType="application/octet-stream" />
        </intent-filter>
        <!-- "Share → Playa Pal" from Files, Drive, Signal, mail. Over-offering
             in a share sheet is the norm, so JSON is claimed here too (legacy
             .json beams from v0.6.x still share in). -->
        <intent-filter>
            <action android:name="android.intent.action.SEND" />
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/vnd.playapal.beam+json" />
            <data android:mimeType="application/octet-stream" />
            <data android:mimeType="application/json" />
        </intent-filter>
      </activity>
      <!-- Crew Phase C: the share-session heartbeat (see CrewShareService's
           header for the consent posture; exported=false — nothing outside
           the app may start or stop a sharing session). -->
      <service
          android:name=".CrewShareService"
          android:exported="false"
          android:foregroundServiceType="location|connectedDevice" />
      <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
        <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
      </provider>
    </application>
</manifest>
