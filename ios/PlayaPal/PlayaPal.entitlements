<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:playapal.lol</string>
		<string>applinks:www.playapal.lol</string>
	</array>
	<!-- llama.rn-recommended for loading multi-GB GGUF models on device:
	     lets a 1.6 GB mmap'd model address cleanly and raises the Jetsam
	     memory ceiling. EAS managed credentials syncs these capabilities
	     onto the App ID automatically. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Walkie rung 4, own-link half (docs/WALKIE-LADDER.md §9): Wi-Fi
	     Aware needs com.apple.developer.wifi-aware ["Publish","Subscribe"]
	     (Apple, "Building peer-to-peer apps", iOS 26).

	     IT IS DELIBERATELY ABSENT, and its own EAS-VERIFY note called this
	     shot: build 85f44108 FAILED to sign — 'Provisioning profile ...
	     doesn't include the Wi-Fi Aware capability'. The capability has to
	     be enabled on the App ID in the Apple Developer portal first (an
	     owner action), and only then can EAS regenerate a profile carrying
	     it. Until that happens the entitlement stays out, because the rung
	     failing downward costs iOS<->iOS hi-fi voice while a signing
	     failure costs the WHOLE APP — including the jetsam fix campers
	     need. The Swift is shipped and inert: without the capability the
	     listener/browser report failed, no peers are contributed, and the
	     walkie rides the shared-LAN rung exactly as it does today.
	     ENABLED on the App ID by the owner 2026-08-25, so the key is back;
	     EAS syncs the capability and regenerates the profile on build. If a
	     future profile ever loses it, the fallback above still applies —
	     drop the key rather than fail the whole app. -->
	<key>com.apple.developer.wifi-aware</key>
	<array>
		<string>Publish</string>
		<string>Subscribe</string>
	</array>
</dict>
</plist>
